# Configuration de la base de données
DATABASE_URL=sqlite:///./database/inventaire.db

# Configuration du serveur API
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Mode debug
DEBUG=True

# Répertoire des exports
EXPORT_DIR=./exports

# Configuration JWT - CRITIQUE pour la sécurité
# Générez une clé aléatoire avec : openssl rand -hex 32
# NE JAMAIS committer cette clé dans git !
SECRET_KEY=changez-cette-cle-en-production
