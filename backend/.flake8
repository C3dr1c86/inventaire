[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    venv,
    __pycache__,
    .git,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # E402: Les imports après code de configuration sont OK
    app/main.py:E402
    app/main-nas.py:E402
    app/main-cors-fix.py:E402
    seed_database.py:E402,F541
    tests/conftest.py:E402
    # E501: Lignes longues OK pour certains fichiers (messages d'erreur, queries SQL)
    app/crud.py:E501
    app/services/export_service.py:E501
