# ============================================
# Configuration NAS - Inventaire v1.6.0
# ============================================

# ===== CONNEXION AU NAS =====
NAS_HOST=192.168.1.100
NAS_USER=admin
NAS_SSH_PORT=22
NAS_DEPLOY_PATH=/volume1/docker/inventaire

# ===== SÉCURITÉ =====
# IMPORTANT: Générer une clé secrète forte avec:
# openssl rand -hex 32
SECRET_KEY=CHANGEME-USE-OPENSSL-RAND-HEX-32-TO-GENERATE

# ===== CONFIGURATION APPLICATION =====
# URL de l'API (remplacer par l'IP de votre NAS)
VITE_API_URL=http://192.168.1.100/api

# Origines CORS autorisées (ajouter l'IP de votre NAS)
CORS_ORIGINS=http://192.168.1.100,http://localhost,http://localhost:80

# ===== PORTS =====
# Port d'accès au frontend (changez si port 80 déjà utilisé)
FRONTEND_PORT=80

# ===== BASE DE DONNÉES =====
# Chemin SQLite (laisser par défaut)
DATABASE_URL=sqlite:///./database/inventaire.db

# ===== IMAGES DOCKER =====
# Version à déployer (latest ou version spécifique comme v1.6.0)
DOCKER_IMAGE_TAG=latest
