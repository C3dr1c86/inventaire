# Configuration Cloudflare Tunnel pour NAS
# Copiez ce fichier en .env et remplissez les valeurs

# ===========================================
# CLOUDFLARE TUNNEL
# ===========================================

# Token obtenu sur https://dash.cloudflare.com/
# Zero Trust > Networks > Tunnels > Create Tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiVOTRE_TOKEN_ICI...

# Votre domaine Cloudflare (ex: inventaire.mondomaine.com)
CLOUDFLARE_DOMAIN=inventaire.votredomaine.com

# ===========================================
# BACKEND
# ===========================================

# Clé secrète JWT (générer avec: openssl rand -hex 32)
SECRET_KEY=ac68ceb02c5ca196e5d82e7290f1c053e08cd865caaea43ffe1da3fe7ad27ca8

# Base de données SQLite
DATABASE_URL=sqlite:///./database/inventaire.db

# CORS - Autoriser votre domaine Cloudflare
CORS_ORIGINS=https://${CLOUDFLARE_DOMAIN},http://localhost

# ===========================================
# FRONTEND
# ===========================================

# URL de l'API (réseau Docker interne)
VITE_API_URL=http://inventaire-backend:8000/api

# ===========================================
# PORTS (Optionnel - pour accès local)
# ===========================================

# Si vous voulez garder l'accès local en plus de Cloudflare
# Décommentez ces lignes dans docker-compose.yml :
# ports:
#   - "8080:80"   # Frontend
#   - "8000:8000" # Backend

# ===========================================
# VOLUMES
# ===========================================

# Chemins sur le NAS (créés automatiquement)
DATA_PATH=./data
DATABASE_PATH=./data/database
EXPORTS_PATH=./data/exports
UPLOADS_PATH=./data/uploads
