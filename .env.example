# Fichier de configuration Docker
# Copiez ce fichier vers .env et modifiez les valeurs

# Clé secrète pour JWT (générez-en une avec: openssl rand -hex 32)
SECRET_KEY=changez-cette-cle-secrete-en-production-avec-une-vraie-cle-aleatoire

# IP de votre NAS sur le réseau local (ex: 192.168.1.100)
# Utilisée par le frontend pour communiquer avec le backend
HOST_IP=localhost
