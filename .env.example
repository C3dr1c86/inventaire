# Configuration de l'application Inventaire

# SECRET_KEY pour JWT (OBLIGATOIRE en production)
# Générer avec: openssl rand -hex 32
SECRET_KEY=changeme-in-production-use-openssl-rand-hex-32

# URL de l'API pour le frontend
# En production avec Nginx reverse proxy, utiliser un chemin relatif "/api"
# En développement ou sans reverse proxy, utiliser l'URL complète
VITE_API_URL=http://localhost:8000/api

# CORS Origins (séparés par des virgules)
# Adapter selon votre domaine en production
CORS_ORIGINS=http://localhost,http://localhost:80,http://your-domain.com

# Database URL (optionnel, par défaut: sqlite:///./database/inventaire.db)
# DATABASE_URL=sqlite:///./database/inventaire.db

# Mode debug (optionnel, défaut: false)
# DEBUG=false
